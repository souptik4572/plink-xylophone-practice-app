# Local model served by Ollama. Fallback for slower laptops: gemma4:e2b
GEMMA_MODEL=gemma4:e4b
OLLAMA_URL=http://127.0.0.1:11434
# Expected first-try success the drill picker aims for (0..1)
DRILL_TARGET=0.80
SESSION_MINUTES=5
# TabPFN model version (spec: TabPFN-3; the library default is v3.5)
TABPFN_MODEL_VERSION=v3
# TabPFN licence key, needed once to download weights (see README)
# TABPFN_TOKEN=
